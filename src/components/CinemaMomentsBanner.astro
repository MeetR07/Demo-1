---
---

<section class="relative w-full bg-[#1E1C1A] py-28 text-white overflow-hidden">
  <!-- Background Thumbnail with Overlay -->
  <div class="absolute inset-0 z-0 opacity-40">
    <img src="/images/hero_3.jpg" alt="Cinema background" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#1E1C1A] via-[#1E1C1A]/80 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-12">
    <!-- Left Quote & Cinema Moments Title (Matching Screenshot 2) -->
    <div class="max-w-2xl space-y-6">
      <p class="text-xs sm:text-sm uppercase tracking-[0.25em] text-white/90 font-sans leading-relaxed">
        CRAFTING TIMELESS VISUAL LEGACIES THROUGH EMOTION, CULTURE & STYLE. 9+ YEARS OF REDEFINING WEDDING STORYTELLING ACROSS INDIA & BEYOND.
      </p>

      <h2 class="font-display text-5xl sm:text-7xl font-normal tracking-wide text-white leading-none">
        Cinema Moments
      </h2>
    </div>

    <!-- Center/Right Play Button (Matching Screenshot 2) -->
    <div class="flex items-center justify-center">
      <button
        id="cinema-moments-play-btn"
        aria-label="Play Cinema Teaser"
        class="group flex h-24 w-24 items-center justify-center rounded-full border border-white/40 bg-white/10 backdrop-blur-md transition-all duration-300 hover:scale-110 hover:border-white hover:bg-white/20 shadow-2xl focus:outline-none"
      >
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-white text-[#1E1C1A] group-hover:scale-105 transition-transform">
          <svg class="h-8 w-8 translate-x-0.5 fill-current" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </button>
    </div>
  </div>

  <!-- Video Popup Modal -->
  <div
    id="cinema-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 p-4 opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <div class="relative w-full max-w-4xl rounded-2xl bg-[#1E1C1A] p-4 border border-white/10 shadow-2xl">
      <div class="flex items-center justify-between pb-3 px-2">
        <h4 class="font-display text-lg text-white font-normal tracking-wider">Cinema Moments Trailer</h4>
        <button id="close-cinema-modal-btn" class="text-white/70 hover:text-white p-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black">
        <iframe
          id="cinema-modal-iframe"
          class="h-full w-full border-0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  const playBtn = document.getElementById('cinema-moments-play-btn');
  const modal = document.getElementById('cinema-modal');
  const closeBtn = document.getElementById('close-cinema-modal-btn');
  const iframe = document.getElementById('cinema-modal-iframe') as HTMLIFrameElement;

  playBtn?.addEventListener('click', () => {
    if (modal && iframe) {
      iframe.src = "https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1";
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      document.body.classList.add('overflow-hidden');
    }
  });

  function closeModal() {
    if (modal && iframe) {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0', 'pointer-events-none');
      iframe.src = "";
      document.body.classList.remove('overflow-hidden');
    }
  }

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>
