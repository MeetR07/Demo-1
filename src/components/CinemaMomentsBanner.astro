---
---

<section class="relative w-full bg-[#12100E] py-24 sm:py-32 text-white overflow-hidden">
  <!-- Background Thumbnail with Cinematic Dark Gradient -->
  <div class="absolute inset-0 z-0 opacity-45">
    <img src="/images/hero_3.jpg" alt="Cinema background" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#12100E] via-[#12100E]/85 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#12100E] via-transparent to-[#12100E]/80"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-8 flex flex-col md:flex-row items-center justify-between gap-10">
    <!-- Left Quote & Cinema Moments Title -->
    <div class="max-w-2xl space-y-5 text-center md:text-left">
      <div class="inline-flex items-center space-x-2 rounded-full border border-white/20 bg-white/10 backdrop-blur-md px-4 py-1">
        <span class="h-1.5 w-1.5 rounded-full bg-[#C5A059] animate-pulse"></span>
        <span class="text-[10px] uppercase tracking-[0.25em] text-[#DFC289] font-sans font-medium">
          4K HDR Cinematic Wedding Films
        </span>
      </div>

      <h2 class="font-display text-4xl sm:text-6xl lg:text-7xl font-normal tracking-wide text-white leading-tight">
        Cinema In Motion
      </h2>

      <p class="text-xs sm:text-sm uppercase tracking-[0.22em] text-white/80 font-sans leading-relaxed font-light">
        CRAFTING TIMELESS VISUAL LEGACIES THROUGH EMOTION, CULTURE & STYLE. 9+ YEARS OF REDEFINING CINEMATIC WEDDING STORYTELLING ACROSS INDIA & BEYOND.
      </p>
    </div>

    <!-- Center/Right Play Button with Pulsing Wave Rings -->
    <div class="flex items-center justify-center pt-4 md:pt-0">
      <button
        id="cinema-moments-play-btn"
        aria-label="Play Cinema Teaser"
        class="group relative flex h-24 w-24 sm:h-28 sm:w-28 items-center justify-center rounded-full border border-[#C5A059]/40 bg-[#C5A059]/20 backdrop-blur-md transition-all duration-500 hover:scale-110 hover:border-[#C5A059] hover:bg-[#C5A059]/30 shadow-2xl focus:outline-none"
      >
        <!-- Outer Glowing Pulse Ring -->
        <div class="absolute inset-0 rounded-full border border-[#C5A059]/50 animate-ping opacity-30"></div>
        
        <div class="flex h-16 w-16 sm:h-18 sm:w-18 items-center justify-center rounded-full bg-white text-[#12100E] group-hover:bg-[#C5A059] group-hover:text-white transition-all shadow-xl">
          <svg class="h-7 w-7 sm:h-8 sm:w-8 translate-x-0.5 fill-current" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </button>
    </div>
  </div>

  <!-- Video Popup Modal -->
  <div
    id="cinema-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/95 p-3 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300 select-none"
  >
    <div class="relative w-full max-w-4xl rounded-2xl bg-[#12100E] p-3 sm:p-4 border border-[#C5A059]/30 shadow-2xl">
      <div class="flex items-center justify-between pb-3 px-2">
        <div class="flex items-center space-x-2">
          <span class="h-2 w-2 rounded-full bg-[#C5A059]"></span>
          <h4 class="font-display text-base sm:text-lg text-white font-normal tracking-wider">Cinema Moments &bull; Official Showreel</h4>
        </div>
        <button id="close-cinema-modal-btn" class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white/80 hover:text-white hover:bg-white/20 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black">
        <iframe
          id="cinema-modal-iframe"
          class="h-full w-full border-0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  const playBtn = document.getElementById('cinema-moments-play-btn');
  const modal = document.getElementById('cinema-modal');
  const closeBtn = document.getElementById('close-cinema-modal-btn');
  const iframe = document.getElementById('cinema-modal-iframe') as HTMLIFrameElement;

  playBtn?.addEventListener('click', () => {
    if (modal && iframe) {
      // High-resolution wedding cinematic showreel
      iframe.src = "https://www.youtube-nocookie.com/embed/5qap5aO4i9A?autoplay=1";
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      document.body.classList.add('overflow-hidden');
    }
  });

  function closeModal() {
    if (modal && iframe) {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0', 'pointer-events-none');
      iframe.src = "";
      document.body.classList.remove('overflow-hidden');
    }
  }

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>
