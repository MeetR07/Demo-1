---
---

<section id="inquire" class="w-full bg-[#FAF8F5] py-20 sm:py-28 border-t border-[#E8E2D9]">
  <div class="mx-auto max-w-4xl px-4 sm:px-8">
    <div class="text-center mb-10 sm:mb-14">
      <div class="inline-flex items-center space-x-2 rounded-full border border-[#C5A059]/40 bg-[#FFFDF9] px-4 py-1.5 mb-3 shadow-sm">
        <span class="text-[10px] sm:text-xs uppercase tracking-[0.25em] text-[#C5A059] font-semibold">
          Let's Begin Your Story
        </span>
      </div>
      <h2 class="font-display text-3xl sm:text-5xl lg:text-6xl font-normal text-[#574838] mb-3">
        Reserve Your Wedding Date
      </h2>
      <p class="text-xs sm:text-sm text-[#78716C] max-w-xl mx-auto font-light leading-relaxed">
        We limit our calendar to a curated number of weddings each season. Share your details below and our team will respond with availability and investment guide within 24 hours.
      </p>
    </div>

    <!-- Form Container -->
    <div class="rounded-3xl bg-white p-6 sm:p-12 shadow-xl border border-[#E8E2D9]">
      <form id="booking-inquiry-form" class="space-y-6 sm:space-y-8">
        <!-- Name Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="partner1" class="block text-xs font-semibold uppercase tracking-[0.15em] text-[#574838] mb-2">
              Bride's Name *
            </label>
            <input
              type="text"
              id="partner1"
              name="partner1"
              required
              placeholder="e.g. Ananya Sharma"
              class="w-full rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] px-4 py-3 text-sm text-[#1C1917] focus:border-[#C5A059] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#C5A059] transition-all"
            />
          </div>
          <div>
            <label for="partner2" class="block text-xs font-semibold uppercase tracking-[0.15em] text-[#574838] mb-2">
              Groom's Name *
            </label>
            <input
              type="text"
              id="partner2"
              name="partner2"
              required
              placeholder="e.g. Sidharth Verma"
              class="w-full rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] px-4 py-3 text-sm text-[#1C1917] focus:border-[#C5A059] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#C5A059] transition-all"
            />
          </div>
        </div>

        <!-- Contact Info Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="email" class="block text-xs font-semibold uppercase tracking-[0.15em] text-[#574838] mb-2">
              Email Address *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="ananya@example.com"
              class="w-full rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] px-4 py-3 text-sm text-[#1C1917] focus:border-[#C5A059] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#C5A059] transition-all"
            />
          </div>
          <div>
            <label for="phone" class="block text-xs font-semibold uppercase tracking-[0.15em] text-[#574838] mb-2">
              Phone / WhatsApp Number *
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              placeholder="+91 98765 43210"
              class="w-full rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] px-4 py-3 text-sm text-[#1C1917] focus:border-[#C5A059] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#C5A059] transition-all"
            />
          </div>
        </div>

        <!-- Event Details Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="eventDate" class="block text-xs font-semibold uppercase tracking-[0.15em] text-[#574838] mb-2">
              Wedding Date(s) *
            </label>
            <input
              type="date"
              id="eventDate"
              name="eventDate"
              required
              class="w-full rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] px-4 py-3 text-sm text-[#1C1917] focus:border-[#C5A059] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#C5A059] transition-all"
            />
          </div>
          <div>
            <label for="location" class="block text-xs font-semibold uppercase tracking-[0.15em] text-[#574838] mb-2">
              Wedding City / Venue *
            </label>
            <input
              type="text"
              id="location"
              name="location"
              required
              placeholder="e.g. City Palace, Udaipur or Mumbai"
              class="w-full rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] px-4 py-3 text-sm text-[#1C1917] focus:border-[#C5A059] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#C5A059] transition-all"
            />
          </div>
        </div>

        <!-- Preferred Package Selection -->
        <div>
          <label for="selectedPackage" class="block text-xs font-semibold uppercase tracking-[0.15em] text-[#574838] mb-2">
            Interested Collection
          </label>
          <select
            id="selectedPackage"
            name="selectedPackage"
            class="w-full rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] px-4 py-3 text-sm text-[#1C1917] focus:border-[#C5A059] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#C5A059] transition-all"
          >
            <option value="The Heritage Heirloom (2-3 Days Photo + Cinema)">The Heritage Heirloom (2-3 Days Photo + Cinema) — Recommended</option>
            <option value="The Royal Extravaganza (Grand Destination + Directed by Bhavin)">The Royal Extravaganza (Grand Destination + Directed by Bhavin)</option>
            <option value="The Intimate Memoir (1 Day Pure Candid Photography)">The Intimate Memoir (1 Day Pure Candid Photography)</option>
            <option value="Custom Bespoke Itinerary">Custom Bespoke Itinerary</option>
          </select>
        </div>

        <!-- Services Needed Checkboxes -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-[0.15em] text-[#574838] mb-3">
            Services Required *
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="flex items-center space-x-3 rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] p-3.5 cursor-pointer hover:border-[#C5A059] transition-colors">
              <input type="checkbox" name="services" value="Photography" checked class="h-4 w-4 accent-[#C5A059]" />
              <span class="text-xs font-medium text-[#1C1917]">Fine Art Candid Photography</span>
            </label>
            <label class="flex items-center space-x-3 rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] p-3.5 cursor-pointer hover:border-[#C5A059] transition-colors">
              <input type="checkbox" name="services" value="Cinematic Film" checked class="h-4 w-4 accent-[#C5A059]" />
              <span class="text-xs font-medium text-[#1C1917]">Cinematic Wedding Films & Teasers</span>
            </label>
            <label class="flex items-center space-x-3 rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] p-3.5 cursor-pointer hover:border-[#C5A059] transition-colors">
              <input type="checkbox" name="services" value="Pre-Wedding" class="h-4 w-4 accent-[#C5A059]" />
              <span class="text-xs font-medium text-[#1C1917]">Pre-Wedding Editorial Shoot</span>
            </label>
            <label class="flex items-center space-x-3 rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] p-3.5 cursor-pointer hover:border-[#C5A059] transition-colors">
              <input type="checkbox" name="services" value="Fine Art Album" checked class="h-4 w-4 accent-[#C5A059]" />
              <span class="text-xs font-medium text-[#1C1917]">Handcrafted Flush-Mount Albums</span>
            </label>
          </div>
        </div>

        <!-- Message Field -->
        <div>
          <label for="message" class="block text-xs font-semibold uppercase tracking-[0.15em] text-[#574838] mb-2">
            Tell Us About Your Celebration & Vision
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Share details about your wedding functions, venue, ceremonies, or any questions..."
            class="w-full rounded-xl border border-[#E8E2D9] bg-[#FAF8F5] p-4 text-sm text-[#1C1917] focus:border-[#C5A059] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#C5A059] transition-all"
          ></textarea>
        </div>

        <!-- Submit Buttons (Normal Form Submit + Direct WhatsApp Inquire) -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <button
            type="submit"
            class="w-full sm:w-auto min-w-[220px] rounded-full bg-[#574838] px-9 py-4 text-xs font-semibold uppercase tracking-[0.2em] text-white shadow-lg transition-all duration-300 hover:bg-[#C5A059] hover:shadow-xl transform hover:-translate-y-0.5 active:scale-95"
          >
            Send Official Inquiry
          </button>
          
          <button
            type="button"
            id="inquiry-whatsapp-btn"
            class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 rounded-full border border-emerald-500 bg-emerald-50 px-7 py-4 text-xs font-semibold uppercase tracking-[0.18em] text-emerald-700 shadow-sm transition-all duration-300 hover:bg-emerald-600 hover:text-white active:scale-95"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
            </svg>
            <span>Inquire on WhatsApp</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Success Confirmation Modal -->
  <div
    id="inquiry-success-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 p-4 opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <div class="bg-[#12100E] max-w-md w-full rounded-3xl p-8 text-center text-[#FAF8F5] border border-[#C5A059]/40 shadow-2xl">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#C5A059]/20 text-[#C5A059] mb-5">
        <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h3 class="font-display text-3xl font-medium text-[#DFC289] mb-2">Inquiry Received</h3>
      <p class="text-xs text-white/80 leading-relaxed font-light mb-6">
        Thank you for reaching out to <strong class="text-white">Stories by Bhavin</strong>. We are thrilled about the prospect of capturing your celebration. Our team will review your dates and respond within 24 hours.
      </p>

      <button
        id="close-success-btn"
        class="w-full rounded-full bg-[#C5A059] px-8 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#12100E] shadow-md hover:bg-white transition-colors"
      >
        Done
      </button>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('booking-inquiry-form');
  const successModal = document.getElementById('inquiry-success-modal');
  const closeSuccessBtn = document.getElementById('close-success-btn');
  const whatsappBtn = document.getElementById('inquiry-whatsapp-btn');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (successModal) {
      successModal.classList.remove('opacity-0', 'pointer-events-none');
      successModal.classList.add('opacity-100');
      (form as HTMLFormElement).reset();
    }
  });

  closeSuccessBtn?.addEventListener('click', () => {
    if (successModal) {
      successModal.classList.remove('opacity-100');
      successModal.classList.add('opacity-0', 'pointer-events-none');
    }
  });

  whatsappBtn?.addEventListener('click', () => {
    const p1 = (document.getElementById('partner1') as HTMLInputElement)?.value || 'Couple';
    const p2 = (document.getElementById('partner2') as HTMLInputElement)?.value || '';
    const date = (document.getElementById('eventDate') as HTMLInputElement)?.value || 'Upcoming Date';
    const city = (document.getElementById('location') as HTMLInputElement)?.value || 'Destination';
    const pkg = (document.getElementById('selectedPackage') as HTMLSelectElement)?.value || 'Wedding Coverage';

    const names = p2 ? `${p1} & ${p2}` : p1;
    const text = `Hi Stories by Bhavin! This is ${names}. We are inquiring for our wedding on ${date} in ${city}. We are interested in ${pkg}.`;
    window.open(`https://wa.me/919876543210?text=${encodeURIComponent(text)}`, '_blank');
  });

  // Connect package buttons from ExperiencePackages section
  document.querySelectorAll('.package-select-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const pkgName = btn.getAttribute('data-package');
      const select = document.getElementById('selectedPackage') as HTMLSelectElement;
      if (select && pkgName) {
        for (let i = 0; i < select.options.length; i++) {
          if (select.options[i].text.includes(pkgName)) {
            select.selectedIndex = i;
            break;
          }
        }
      }
    });
  });
</script>
