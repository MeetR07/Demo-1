---
const gridPhotos = [
  { src: "/images/grid_1.jpg", title: "Royal B&W Portrait", category: "Bridal Editorial" },
  { src: "/images/grid_4.jpg", title: "Sun-Drenched Haldi", category: "Ceremony" },
  { src: "/images/grid_2.jpg", title: "Champagne Tower Pour", category: "Reception" },
  { src: "/images/grid_5.jpg", title: "Sangeet Pyros Dance", category: "Sangeet Night" },
  { src: "/images/grid_3.jpg", title: "Phoolon Ki Chadar", category: "Bridal Entry" },
  { src: "/images/udaipur.jpg", title: "Udaipur Palace Courtyard", category: "Destination" },
  { src: "/images/jaipur.jpg", title: "Jaipur Heritage Frescoes", category: "Heritage Royal" },
  { src: "/images/hero_1.jpg", title: "Rajasthan Sunset Glow", category: "Couple Portrait" },
  { src: "/images/hero_2.jpg", title: "Goa Beach Romance", category: "Pre-Wedding" },
  { src: "/images/hero_3.jpg", title: "Night Fireworks Canopy", category: "Grand Reception" },
  { src: "/images/film_1.jpg", title: "Mandap Laughter", category: "Candid Moments" },
  { src: "/images/film_2.jpg", title: "Taj Lands End Whirl", category: "Mumbai Moments" },
];
---

<section class="w-full bg-[#F3F2EE] py-20 border-b border-[#E7E3DF]">
  <div class="mx-auto max-w-[1480px] px-4 sm:px-8">
    <div class="text-center mb-12">
      <span class="text-xs uppercase tracking-[0.3em] text-[#6B5D4F] font-semibold block mb-2">
        Curated Gallery
      </span>
      <h2 class="font-display text-3xl sm:text-5xl font-normal text-[#6B5D4F]">
        Moments Frozen In Time
      </h2>
      <p class="text-xs text-[#2C2C2C] max-w-lg mx-auto font-light leading-relaxed mt-2">
        Click any photograph to view in full-resolution lightbox viewer.
      </p>
    </div>

    <!-- 3-Column / 4-Column Responsive Masonry Grid with Reduced Side Spacing -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6">
      {
        gridPhotos.map((photo) => (
          <div
            class="middle-photo-item group relative aspect-square overflow-hidden bg-[#1E1C1A] cursor-pointer rounded-lg border border-[#E7E3DF] shadow-sm transform transition-all duration-500 hover:-translate-y-1 hover:shadow-xl"
            data-src={photo.src}
            data-title={photo.title}
          >
            <img
              src={photo.src}
              alt={photo.title}
              class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-110 opacity-95 group-hover:opacity-100"
              loading="lazy"
            />
            
            <!-- Hover Overlay Info -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-between p-6">
              <span class="text-[10px] uppercase tracking-[0.25em] text-[#9F9483] font-semibold">
                {photo.category}
              </span>
              <div>
                <h4 class="font-display text-xl text-white font-normal mb-2">
                  {photo.title}
                </h4>
                <span class="inline-flex items-center text-[10px] uppercase tracking-[0.2em] text-[#9F9483] font-medium">
                  View Photo
                  <svg class="w-3 h-3 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Interactive Lightbox Modal -->
  <div
    id="middle-grid-lightbox"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 p-4 opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <button
      id="close-lightbox-btn"
      class="absolute top-6 right-6 text-white/80 hover:text-white p-2 focus:outline-none"
      aria-label="Close Lightbox"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="flex flex-col items-center max-w-[90vw] max-h-[85vh]">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-h-[80vh] max-w-[90vw] object-contain rounded shadow-2xl"
      />
      <h4 id="lightbox-caption" class="font-display text-lg text-white font-light tracking-wider mt-4"></h4>
    </div>
  </div>
</section>

<script>
  const photoItems = document.querySelectorAll('.middle-photo-item');
  const lightbox = document.getElementById('middle-grid-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const closeBtn = document.getElementById('close-lightbox-btn');

  photoItems.forEach(item => {
    item.addEventListener('click', () => {
      const src = item.getAttribute('data-src') || '';
      const title = item.getAttribute('data-title') || '';
      if (lightbox && lightboxImg && lightboxCaption) {
        lightboxImg.src = src;
        lightboxCaption.textContent = title;
        lightbox.classList.remove('opacity-0', 'pointer-events-none');
        lightbox.classList.add('opacity-100');
        document.body.classList.add('overflow-hidden');
      }
    });
  });

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.remove('opacity-100');
      lightbox.classList.add('opacity-0', 'pointer-events-none');
      document.body.classList.remove('overflow-hidden');
    }
  }

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
</script>
