---
const films = [
  {
    title: "RIA + KASHYAP - UDAIPUR PALACE",
    couple: "Ria & Kashyap",
    location: "City Palace, Udaipur",
    duration: "5:40 MIN",
    cover: "/images/hero_1.jpg",
    videoUrl: "https://www.youtube-nocookie.com/embed/5qap5aO4i9A?autoplay=1",
  },
  {
    title: "RAHUL + SONALI - TAJ LANDS END",
    couple: "Rahul & Sonali",
    location: "Bandra, Mumbai",
    duration: "4:15 MIN",
    cover: "/images/film_2.jpg",
    videoUrl: "https://www.youtube-nocookie.com/embed/5qap5aO4i9A?autoplay=1",
  },
  {
    title: "RHEA + KABIR - GOA BEACHFRONT",
    couple: "Rhea & Kabir",
    location: "South Goa",
    duration: "6:10 MIN",
    cover: "/images/hero_2.jpg",
    videoUrl: "https://www.youtube-nocookie.com/embed/5qap5aO4i9A?autoplay=1",
  },
  {
    title: "NATASHA + VARUN - JAIPUR HERITAGE",
    couple: "Natasha & Varun",
    location: "Samode Palace, Jaipur",
    duration: "5:05 MIN",
    cover: "/images/film_1.jpg",
    videoUrl: "https://www.youtube-nocookie.com/embed/5qap5aO4i9A?autoplay=1",
  },
];
---

<section id="films" class="w-full bg-[#FAF8F5] py-20 sm:py-28 text-[#1C1917] border-b border-[#E8E2D9]">
  <div class="mx-auto max-w-7xl px-4 sm:px-8">
    <!-- Header Philosophy -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16 space-y-4">
      <div class="inline-flex items-center space-x-2 rounded-full border border-[#C5A059]/40 bg-[#FFFDF9] px-4 py-1.5 shadow-sm">
        <span class="text-[10px] sm:text-xs uppercase tracking-[0.25em] text-[#C5A059] font-semibold">
          Art In Motion
        </span>
      </div>

      <h2 class="font-display text-3xl sm:text-5xl lg:text-6xl font-normal text-[#574838] tracking-tight">
        Wedding Cinema Highlights
      </h2>

      <p class="text-xs sm:text-sm text-[#78716C] leading-relaxed font-light">
        We capture the vibe of the celebration, the authentic emotion of the vows, and the electric energy of the dance floor. Every frame is hand-colored with cinematic grade tones.
      </p>
    </div>

    <!-- 2x2 Grid of 4 Cinematic Video Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
      {
        films.map((film) => (
          <div class="group flex flex-col">
            <!-- Video Thumbnail Frame with Play Button Overlay -->
            <div class="relative aspect-video w-full overflow-hidden rounded-2xl bg-[#12100E] mb-4 shadow-lg border border-[#E8E2D9] group-hover:border-[#C5A059]/60 transition-colors">
              <img
                src={film.cover}
                alt={film.title}
                class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-106 opacity-90 group-hover:opacity-100"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent group-hover:from-black/50 transition-colors"></div>

              <!-- Duration Badge Top Right -->
              <div class="absolute top-3 right-3 rounded-full bg-black/60 backdrop-blur-md px-3 py-1 text-[10px] font-mono tracking-widest text-white/90 border border-white/20">
                {film.duration}
              </div>

              <!-- Play Circle Overlay Button -->
              <button
                class="film-play-btn absolute inset-0 m-auto flex h-16 w-16 items-center justify-center rounded-full bg-white/25 border border-white/70 backdrop-blur-md text-white shadow-2xl transition-all duration-300 transform group-hover:scale-110 hover:bg-[#C5A059] hover:border-[#C5A059] hover:text-white focus:outline-none"
                data-title={film.title}
                data-video={film.videoUrl}
                aria-label={`Play film ${film.title}`}
              >
                <svg class="h-7 w-7 translate-x-0.5 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>

              <!-- Couple & Location Overlay Bottom Left -->
              <div class="absolute bottom-3.5 left-4 right-4 flex items-center justify-between text-white">
                <div>
                  <h3 class="font-display text-lg sm:text-xl font-medium tracking-wide">
                    {film.couple}
                  </h3>
                  <span class="text-[10px] uppercase tracking-[0.2em] text-[#DFC289]">
                    {film.location}
                  </span>
                </div>
              </div>
            </div>

            <!-- Title Below Video Card -->
            <div class="flex items-center justify-between px-1">
              <span class="text-xs uppercase tracking-[0.22em] font-sans font-semibold text-[#574838] group-hover:text-[#C5A059] transition-colors">
                {film.title}
              </span>
              <span class="text-[11px] text-[#78716C] font-light">
                Watch Film &rarr;
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Video Popup Modal -->
  <div
    id="film-video-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/95 p-3 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300 select-none"
  >
    <div class="relative w-full max-w-4xl rounded-2xl bg-[#12100E] p-3 sm:p-4 border border-[#C5A059]/30 shadow-2xl">
      <div class="flex items-center justify-between pb-3 px-2">
        <h4 id="film-modal-title" class="font-display text-base sm:text-lg text-white font-normal tracking-wider">Wedding Film Trailer</h4>
        <button id="close-film-modal-btn" class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white/80 hover:text-white hover:bg-white/20 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black">
        <iframe
          id="film-modal-iframe"
          class="h-full w-full border-0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  const filmBtns = document.querySelectorAll('.film-play-btn');
  const filmModal = document.getElementById('film-video-modal');
  const closeFilmBtn = document.getElementById('close-film-modal-btn');
  const filmIframe = document.getElementById('film-modal-iframe') as HTMLIFrameElement;
  const filmTitle = document.getElementById('film-modal-title');

  filmBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const videoUrl = btn.getAttribute('data-video') || '';
      const title = btn.getAttribute('data-title') || '';
      if (filmIframe && filmModal && filmTitle) {
        filmIframe.src = videoUrl;
        filmTitle.textContent = title;
        filmModal.classList.remove('opacity-0', 'pointer-events-none');
        filmModal.classList.add('opacity-100');
        document.body.classList.add('overflow-hidden');
      }
    });
  });

  function closeFilmModal() {
    if (filmModal && filmIframe) {
      filmModal.classList.remove('opacity-100');
      filmModal.classList.add('opacity-0', 'pointer-events-none');
      filmIframe.src = '';
      document.body.classList.remove('overflow-hidden');
    }
  }

  closeFilmBtn?.addEventListener('click', closeFilmModal);
  filmModal?.addEventListener('click', (e) => {
    if (e.target === filmModal) closeFilmModal();
  });
</script>
