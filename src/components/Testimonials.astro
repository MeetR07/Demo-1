---
const reviews = [
  {
    image: "/images/hero_2.jpg",
    couple: "HARSHITA & NICKY",
    role: "Couple",
    quote: "We absolutely loved working with Stories by Bhavin! They captured every special moment of our wedding beautifully, and their team made us feel so comfortable and at ease throughout the day. The photos are stunning, full of emotion, and truly tell the story of our day. We couldn't be happier with how everything turned out. Highly recommend them for anyone looking for amazing, heartfelt photography!",
  },
  {
    image: "/images/udaipur.jpg",
    couple: "ANANYA & SIDHARTH",
    role: "Couple",
    quote: "Bhavin and his team felt like family from day one. Looking back at our wedding film and album brings tears of joy every single time. Their ability to capture genuine emotion without feeling posed is unmatched!",
  },
  {
    image: "/images/jaipur.jpg",
    couple: "NATASHA & VARUN",
    role: "Couple",
    quote: "Pure magic. The cinematic trailer they delivered looks like a Bollywood movie trailer! Professional, discreet, and extremely talented artists who cared about every small detail.",
  },
];
---

<section class="relative w-full bg-[#1E1C1A] py-24 text-white overflow-hidden">
  <!-- Background Image with Blur & Tint Overlay (Matching Screenshot 5) -->
  <div id="testimonial-bg-wrap" class="absolute inset-0 z-0">
    <img
      id="testimonial-bg-img"
      src="/images/hero_2.jpg"
      alt="Testimonial background"
      class="h-full w-full object-cover opacity-25 filter blur-md transition-all duration-700"
    />
    <div class="absolute inset-0 bg-black/60"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6 md:px-10">
    <div id="testimonial-slides-container" class="relative min-h-[380px]">
      {
        reviews.map((review, index) => (
          <div
            class={`testimonial-slide transition-opacity duration-700 ease-in-out ${
              index === 0 ? "opacity-100 relative z-10" : "opacity-0 absolute inset-0 pointer-events-none z-0"
            }`}
            data-index={index}
            data-bg={review.image}
          >
            <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
              <!-- Left Square Photo Frame (Matching Screenshot 5) -->
              <div class="md:col-span-5 flex justify-center md:justify-start">
                <div class="w-64 h-64 sm:w-80 sm:h-80 rounded overflow-hidden shadow-2xl border-4 border-white/20">
                  <img
                    src={review.image}
                    alt={review.couple}
                    class="h-full w-full object-cover object-center"
                    loading="lazy"
                  />
                </div>
              </div>

              <!-- Right Content Block (Matching Screenshot 5) -->
              <div class="md:col-span-7 space-y-6">
                <span class="text-xs uppercase tracking-[0.25em] text-white/80 font-sans block">
                  Testimonials
                </span>

                <p class="font-sans text-sm sm:text-base leading-relaxed text-white/95 font-light">
                  "{review.quote}"
                </p>

                <div class="pt-2">
                  <h4 class="font-sans text-xs uppercase tracking-[0.25em] font-semibold text-white">
                    {review.couple}
                  </h4>
                  <span class="text-[11px] font-sans text-white/70 font-light block">
                    {review.role}
                  </span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Bottom Controls Counter `< 1 / 3 >` (Matching Screenshot 5) -->
    <div class="flex items-center space-x-6 text-sm text-white/90 pt-8 border-t border-white/10 mt-8">
      <button
        id="testimonial-prev-btn"
        class="p-2 hover:text-[#9F9483] transition-colors focus:outline-none"
        aria-label="Previous Testimonial"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <span class="font-sans font-light text-xs tracking-[0.2em]">
        <span id="testimonial-current-num">1</span>
        <span class="opacity-50 mx-1">/</span>
        <span>{reviews.length}</span>
      </span>

      <button
        id="testimonial-next-btn"
        class="p-2 hover:text-[#9F9483] transition-colors focus:outline-none"
        aria-label="Next Testimonial"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  let currentIndex = 0;
  const slides = document.querySelectorAll('.testimonial-slide');
  const totalSlides = slides.length;
  const currentNumEl = document.getElementById('testimonial-current-num');
  const bgImg = document.getElementById('testimonial-bg-img') as HTMLImageElement;

  function goToSlide(index: number) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0', 'absolute');
        slide.classList.add('opacity-100', 'relative', 'z-10');
        const bg = slide.getAttribute('data-bg');
        if (bgImg && bg) bgImg.src = bg;
      } else {
        slide.classList.remove('opacity-100', 'relative', 'z-10');
        slide.classList.add('opacity-0', 'pointer-events-none', 'z-0', 'absolute');
      }
    });
    if (currentNumEl) currentNumEl.textContent = (index + 1).toString();
    currentIndex = index;
  }

  document.getElementById('testimonial-next-btn')?.addEventListener('click', () => {
    const next = (currentIndex + 1) % totalSlides;
    goToSlide(next);
  });

  document.getElementById('testimonial-prev-btn')?.addEventListener('click', () => {
    const prev = (currentIndex - 1 + totalSlides) % totalSlides;
    goToSlide(prev);
  });
</script>
