---
const instaFeed = [
  { img: "/images/hero_1.jpg", link: "https://instagram.com" },
  { img: "/images/hero_2.jpg", link: "https://instagram.com" },
  { img: "/images/hero_3.jpg", link: "https://instagram.com" },
  { img: "/images/udaipur.jpg", link: "https://instagram.com" },
  { img: "/images/jaipur.jpg", link: "https://instagram.com" },
  { img: "/images/bhavin.jpg", link: "https://instagram.com" },
];
---

<footer class="w-full bg-[#0A0908] text-[#FAF8F5] border-t border-white/10 relative pb-16 lg:pb-0">
  <!-- Instagram Preview Bar -->
  <div class="border-b border-white/10 py-10 bg-[#12100E]/70">
    <div class="mx-auto max-w-7xl px-4 sm:px-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6 text-center sm:text-left">
        <div>
          <span class="text-[10px] uppercase tracking-[0.3em] text-[#C5A059] font-semibold block mb-1">
            Follow Our Global Journey
          </span>
          <h3 class="font-display text-2xl font-normal text-white">
            @storiesbybhavin
          </h3>
        </div>
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center space-x-2 rounded-full border border-white/25 px-5 py-2 text-xs uppercase tracking-[0.15em] text-[#FAF8F5] transition-all hover:border-[#C5A059] hover:text-[#C5A059] hover:bg-white/5 active:scale-95"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
          <span>Instagram Feed</span>
        </a>
      </div>

      <!-- Instagram Grid -->
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 sm:gap-3">
        {
          instaFeed.map((item) => (
            <a
              href={item.link}
              target="_blank"
              rel="noopener"
              class="group relative aspect-square overflow-hidden rounded-xl bg-black border border-white/10"
            >
              <img
                src={item.img}
                alt="Instagram post preview"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-75 group-hover:opacity-100"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-[#C5A059]/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <svg class="w-5 h-5 text-black" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Main Footer Section -->
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <!-- Brand & Mission -->
      <div class="md:col-span-5 space-y-4">
        <span class="font-display text-2xl sm:text-3xl font-bold tracking-widest text-[#DFC289] block">
          STORIES BY BHAVIN
        </span>
        <p class="text-xs text-white/70 leading-relaxed font-light max-w-sm">
          Fine Art Wedding Photography & Cinematic Films. Based in Mumbai, capturing timeless stories of love, culture, and emotion across India and worldwide destinations.
        </p>
        <div class="flex items-center space-x-2 text-[11px] text-[#C5A059] font-mono pt-2">
          <span>Available: Mumbai &bull; Udaipur &bull; Goa &bull; London &bull; Dubai</span>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-[#DFC289]">Navigation</h4>
        <ul class="space-y-2 text-xs text-white/70 font-light">
          <li><a href="/" class="hover:text-[#C5A059] transition-colors">Home</a></li>
          <li><a href="#weddings" class="hover:text-[#C5A059] transition-colors">Featured Weddings</a></li>
          <li><a href="#gallery" class="hover:text-[#C5A059] transition-colors">Curated Gallery</a></li>
          <li><a href="#films" class="hover:text-[#C5A059] transition-colors">Wedding Films</a></li>
          <li><a href="#packages" class="hover:text-[#C5A059] transition-colors">Experience & Collections</a></li>
          <li><a href="/about" class="hover:text-[#C5A059] transition-colors">About Bhavin</a></li>
          <li><a href="/faq" class="hover:text-[#C5A059] transition-colors">Frequently Asked Questions</a></li>
          <li><a href="/contact" class="hover:text-[#C5A059] transition-colors">Reserve Your Date</a></li>
        </ul>
      </div>

      <!-- Direct Contact Info -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-[#DFC289]">Get In Touch</h4>
        <p class="text-xs text-white/70 font-light leading-relaxed">
          Studio 402, Bandra West, Mumbai, Maharashtra 400050<br />
          Email: <a href="mailto:hello@storiesbybhavin.com" class="text-white hover:text-[#C5A059] underline">hello@storiesbybhavin.com</a><br />
          Phone: <a href="tel:+919876543210" class="text-white hover:text-[#C5A059]">+91 98765 43210</a>
        </p>
        <div class="pt-3">
          <a
            href="https://wa.me/919876543210?text=Hi%20Stories%20by%20Bhavin,%20I'd%20like%20to%20check%20wedding%20dates!"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center space-x-2 rounded-full bg-emerald-600 px-5 py-2.5 text-xs font-medium text-white shadow hover:bg-emerald-700 transition-colors"
          >
            <span>Chat on WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright Footer -->
    <div class="mt-14 border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between text-[11px] text-white/50 gap-2">
      <p>&copy; {new Date().getFullYear()} Stories by Bhavin. All rights reserved.</p>
      <p>Bespoke Fine Art Photography Studio &bull; Handcrafted with Passion</p>
    </div>
  </div>

  <!-- Floating Desktop WhatsApp Button (Elevated on mobile above bottom bar) -->
  <a
    href="https://wa.me/919876543210?text=Hi%20Stories%20by%20Bhavin,%20I'm%20inquiring%20about%20wedding%20photography%20dates!"
    target="_blank"
    rel="noopener"
    aria-label="Chat on WhatsApp"
    class="hidden lg:flex fixed bottom-6 right-6 z-40 h-14 w-14 items-center justify-center rounded-full bg-emerald-500 text-white shadow-2xl transition-all duration-300 hover:scale-110 hover:bg-emerald-600 focus:outline-none"
  >
    <svg class="h-7 w-7 fill-current" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
    </svg>
  </a>
</footer>

