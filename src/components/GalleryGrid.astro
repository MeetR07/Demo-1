---
// One reusable grid used by the Wedding, Editorial and Films hub pages —
// change the template once, every hub page updates.
interface Item {
  href: string;
  cover: string;
  title: string;
  location: string;
  date: Date;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item) => (
      <a href={item.href} class="group block">
        <div class="aspect-[4/5] overflow-hidden rounded bg-rule/40">
          <img
            src={item.cover}
            alt={item.title}
            loading="lazy"
            class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
          />
        </div>
        <h3 class="mt-3 font-display text-xl text-ink">{item.title}</h3>
        <p class="text-sm text-inksoft">
          {item.location} &middot;{" "}
          {item.date.toLocaleDateString("en-IN", { month: "long", year: "numeric" })}
        </p>
      </a>
    ))
  }
</div>
