---
---

<section id="about-teaser" class="w-full bg-paper py-24 border-t border-border-light">
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Portrait Image Column -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-border-light">
          <img
            src="/images/bhavin.jpg"
            alt="Bhavin - Founder & Principal Director"
            class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
          />
        </div>
        <!-- Decorative Badge -->
        <div class="absolute -bottom-6 -right-6 rounded-2xl bg-paper-dark p-6 text-paper shadow-xl border border-white/10 hidden sm:block">
          <span class="font-display text-4xl font-bold text-gold block">12+</span>
          <span class="text-[10px] uppercase tracking-[0.2em] text-white/70">Years of Storytelling</span>
        </div>
      </div>

      <!-- Text Philosophy Column -->
      <div class="lg:col-span-7 space-y-6">
        <span class="text-xs uppercase tracking-[0.3em] text-gold font-semibold block">
          Behind The Lens
        </span>
        <h2 class="font-display text-4xl sm:text-5xl font-semibold text-ink leading-tight">
          "We don't just photograph weddings — we preserve feelings for generations to come."
        </h2>

        <p class="text-sm text-ink-muted leading-relaxed font-light">
          Hi, I’m Bhavin. Over the past decade, my team and I have had the privilege of documenting over 500 weddings across India, Southern Europe, Southeast Asia, and the Middle East.
        </p>

        <p class="text-sm text-ink-muted leading-relaxed font-light">
          Our approach is unobtrusive, artistic, and deeply human. We focus on candid glances, shared laughter between grandmothers and brides, the electric energy of the Sangeet floor, and quiet, romantic moments at sunset.
        </p>

        <!-- Key Highlights Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 pt-6 border-t border-border-light">
          <div>
            <span class="font-display text-3xl font-bold text-ink">500+</span>
            <span class="block text-[11px] uppercase tracking-[0.15em] text-ink-muted mt-1">Weddings Covered</span>
          </div>
          <div>
            <span class="font-display text-3xl font-bold text-ink">15+</span>
            <span class="block text-[11px] uppercase tracking-[0.15em] text-ink-muted mt-1">Countries Travelled</span>
          </div>
          <div>
            <span class="font-display text-3xl font-bold text-ink">100%</span>
            <span class="block text-[11px] uppercase tracking-[0.15em] text-ink-muted mt-1">Heart & Passion</span>
          </div>
        </div>

        <div class="pt-4">
          <a
            href="/about"
            class="inline-flex items-center space-x-3 rounded-full bg-ink px-8 py-3.5 text-xs font-semibold uppercase tracking-[0.2em] text-paper shadow-md transition-all hover:bg-gold hover:text-ink"
          >
            <span>Discover Our Story</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
