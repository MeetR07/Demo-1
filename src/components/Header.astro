---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "Weddings", href: "/wedding" },
  { name: "Films", href: "/films" },
  { name: "Editorial", href: "/editorial" },
  { name: "About Bhavin", href: "/about" },
  { name: "FAQs", href: "/faq" },
  { name: "Contact", href: "/contact" },
];
---

<header class="sticky top-0 z-40 w-full bg-[#FAF8F5]/95 backdrop-blur-md border-b border-[#E8E2D9] transition-all duration-300 shadow-sm">
  <div class="mx-auto flex max-w-[1480px] items-center justify-between px-3 sm:px-8 py-2.5 sm:py-4">
    <!-- Brand Logo with Camera Monogram Emblem -->
    <a href="/" class="flex items-center space-x-2 sm:space-x-3 group shrink-0">
      <div class="relative flex h-8 w-8 sm:h-11 sm:w-11 items-center justify-center rounded-full border border-[#C5A059]/60 bg-[#FFFDF9] shadow-sm transition-all duration-500 group-hover:scale-105 group-hover:border-[#C5A059]">
        <svg class="h-4 w-4 sm:h-6 sm:w-6 text-[#C5A059] transition-colors group-hover:text-[#936F32]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="9" class="stroke-[#C5A059]/40" stroke-width="1" />
          <circle cx="12" cy="12" r="4" stroke-width="1" />
          <path stroke-linecap="round" d="M12 3v3M12 18v3M3 12h3M18 12h3" stroke-width="1" />
          <text x="12" y="15.5" font-family="'Cormorant Garamond', serif" font-size="9" font-weight="700" text-anchor="middle" fill="#574838" stroke="none">SB</text>
        </svg>
      </div>

      <!-- Logo Typography -->
      <div class="flex flex-col">
        <span class="font-display text-sm sm:text-2xl font-bold tracking-[0.12em] sm:tracking-[0.18em] text-[#574838] group-hover:text-[#1C1917] transition-colors leading-none whitespace-nowrap">
          STORIES BY BHAVIN
        </span>
        <span class="text-[7px] sm:text-[9.5px] uppercase tracking-[0.18em] sm:tracking-[0.28em] text-[#78716C] font-sans font-medium mt-0.5 sm:mt-1 whitespace-nowrap">
          Fine Art Wedding Photography
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden items-center space-x-7 xl:space-x-8 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="relative text-xs uppercase tracking-[0.18em] font-medium text-[#44403C] hover:text-[#C5A059] transition-colors duration-200 py-1 hover-gold-line"
          >
            {link.name}
          </a>
        ))
      }
    </nav>

    <!-- Header Actions (Visible on BOTH Desktop & Mobile screens) -->
    <div class="flex items-center space-x-1.5 sm:space-x-3 shrink-0">
      <!-- Reserve Date Button (Always visible on mobile & desktop) -->
      <a
        href="/contact"
        class="inline-flex items-center space-x-1 sm:space-x-1.5 rounded-full bg-[#574838] hover:bg-[#C5A059] px-2.5 sm:px-5 py-1.5 sm:py-2 text-[9.5px] sm:text-xs font-semibold uppercase tracking-[0.12em] sm:tracking-[0.15em] text-white shadow-sm hover:shadow active:scale-95 transition-all whitespace-nowrap"
      >
        <span>Reserve Date</span>
        <svg class="w-2.5 h-2.5 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- WhatsApp Quick Ping (Tablet & Desktop - on mobile it is in the bottom bar & drawer) -->
      <a
        href="https://wa.me/919876543210?text=Hi%20Stories%20by%20Bhavin,%20I'd%20like%20to%20check%20wedding%20photography%20availability!"
        target="_blank"
        rel="noopener"
        aria-label="Direct WhatsApp message"
        class="hidden sm:flex h-8.5 w-8.5 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 border border-emerald-200 shadow-sm active:scale-95 transition-transform"
      >
        <svg class="h-4.5 w-4.5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
      </a>

      <!-- 3-Lines Hamburger Menu Button for Mobile Drawer -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Open Navigation Menu"
        class="flex h-8.5 w-8.5 sm:h-10 sm:w-10 items-center justify-center rounded-lg border border-[#E8E2D9] bg-[#FFFDF9] text-[#574838] focus:outline-none active:scale-90 hover:border-[#C5A059] transition-all lg:hidden"
      >
        <svg class="h-4.5 w-4.5 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

