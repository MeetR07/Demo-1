---
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isWeddings = pathname.startsWith("/wedding");
const isFilms = pathname.startsWith("/films");
const isContact = pathname.startsWith("/contact");
---

<!-- Mobile Bottom Navigation Dock (Fixed permanently on ALL pages for mobile/tablet) -->
<nav
  id="mobile-bottom-bar"
  class="fixed bottom-0 left-0 right-0 z-[100] block lg:hidden w-full border-t border-[#E8E2D9] bg-[#FAF8F5]/98 backdrop-blur-xl shadow-[0_-4px_25px_rgba(0,0,0,0.08)] select-none"
  style="padding-bottom: max(6px, env(safe-area-inset-bottom));"
  aria-label="Mobile bottom navigation"
>
  <div class="grid grid-cols-5 items-center w-full max-w-md mx-auto px-0.5 py-1">
    <!-- 1. Home -->
    <a
      href="/"
      class={`flex flex-col items-center justify-center py-1 transition-all active:scale-90 ${
        isHome ? "text-[#C5A059]" : "text-[#574838] hover:text-[#C5A059]"
      }`}
    >
      <div class="relative">
        <svg class="h-5 w-5" fill={isHome ? "currentColor" : "none"} stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        {isHome && <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 h-1 w-1 rounded-full bg-[#C5A059]" />}
      </div>
      <span class="text-[9.5px] uppercase tracking-wider font-semibold mt-1 leading-none">Home</span>
    </a>

    <!-- 2. Weddings -->
    <a
      href="/wedding"
      class={`flex flex-col items-center justify-center py-1 transition-all active:scale-90 ${
        isWeddings ? "text-[#C5A059]" : "text-[#574838] hover:text-[#C5A059]"
      }`}
    >
      <div class="relative">
        <svg class="h-5 w-5" fill={isWeddings ? "currentColor" : "none"} stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {isWeddings && <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 h-1 w-1 rounded-full bg-[#C5A059]" />}
      </div>
      <span class="text-[9.5px] uppercase tracking-wider font-semibold mt-1 leading-none">Weddings</span>
    </a>

    <!-- 3. Center CTA: Reserve / Book -->
    <a
      href="/contact"
      class="flex flex-col items-center justify-center active:scale-95 transition-transform"
      aria-label="Reserve Wedding Date"
    >
      <div class={`flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full shadow-md border-2 transition-all ${
        isContact
          ? "bg-[#C5A059] border-white text-white"
          : "bg-[#574838] border-white text-[#DFC289] hover:bg-[#C5A059] hover:text-white"
      }`}>
        <svg class="h-4 w-4 sm:h-4.5 sm:w-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <span class="text-[9px] uppercase tracking-wider font-bold text-[#574838] mt-0.5 leading-none">Book</span>
    </a>

    <!-- 4. Films -->
    <a
      href="/films"
      class={`flex flex-col items-center justify-center py-1 transition-all active:scale-90 ${
        isFilms ? "text-[#C5A059]" : "text-[#574838] hover:text-[#C5A059]"
      }`}
    >
      <div class="relative">
        <svg class="h-5 w-5" fill={isFilms ? "currentColor" : "none"} stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        {isFilms && <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 h-1 w-1 rounded-full bg-[#C5A059]" />}
      </div>
      <span class="text-[9.5px] uppercase tracking-wider font-semibold mt-1 leading-none">Films</span>
    </a>

    <!-- 5. WhatsApp -->
    <a
      href="https://wa.me/919876543210?text=Hi%20Stories%20by%20Bhavin,%20I'd%20like%20to%20inquire%20about%20wedding%20photography%20availability!"
      target="_blank"
      rel="noopener"
      class="flex flex-col items-center justify-center py-1 text-emerald-600 hover:text-emerald-700 active:scale-90 transition-all"
    >
      <div class="relative">
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
      </div>
      <span class="text-[9.5px] uppercase tracking-wider font-semibold mt-1 leading-none">Chat</span>
    </a>
  </div>
</nav>
