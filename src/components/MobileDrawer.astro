---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "Real Weddings", href: "/wedding" },
  { name: "Wedding Films", href: "/films" },
  { name: "Editorial Stories", href: "/editorial" },
  { name: "About Bhavin", href: "/about" },
  { name: "Frequently Asked Questions", href: "/faq" },
  { name: "Contact & Booking", href: "/contact" },
];
---

<!-- Fullscreen Mobile Navigation Drawer (Attached directly to body) -->
<div
  id="mobile-nav-drawer"
  class="fixed inset-0 z-[999] flex flex-col justify-between bg-[#FAF8F5] text-[#1C1917] transition-all duration-400 ease-in-out lg:hidden translate-x-full opacity-0 pointer-events-none overflow-y-auto"
  style="min-height: 100vh; min-height: 100dvh;"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
>
  <!-- Drawer Top Bar -->
  <div class="flex items-center justify-between border-b border-[#E8E2D9] px-6 py-4 bg-[#FFFDF9] sticky top-0 z-10 shadow-sm">
    <div class="flex items-center space-x-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-full border border-[#C5A059] bg-[#FAF8F5] shadow-sm">
        <span class="font-display font-bold text-xs text-[#574838]">SB</span>
      </div>
      <div class="flex flex-col">
        <span class="font-display text-base font-bold tracking-[0.14em] text-[#574838]">STORIES BY BHAVIN</span>
        <span class="text-[8.5px] uppercase tracking-[0.25em] text-[#78716C] font-sans">Fine Art Wedding Photography</span>
      </div>
    </div>

    <!-- Prominent Close Button -->
    <button
      id="close-mobile-drawer-btn"
      type="button"
      aria-label="Close navigation menu"
      class="flex h-10 w-10 items-center justify-center rounded-full border border-[#E8E2D9] bg-white text-[#574838] shadow-sm active:scale-90 hover:bg-[#FAF8F5] transition-all"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Navigation Menu Links -->
  <div class="px-6 py-6 flex flex-col space-y-1 my-auto">
    <span class="text-[9px] uppercase tracking-[0.3em] text-[#C5A059] font-semibold mb-2">
      Menu Navigation
    </span>

    {
      navLinks.map((link, idx) => (
        <a
          href={link.href}
          class="mobile-drawer-link group flex items-center justify-between py-3.5 border-b border-[#E8E2D9]/60 text-[#1C1917] hover:text-[#C5A059] active:bg-[#FAF8F5] transition-colors"
        >
          <span class="font-display text-2xl sm:text-3xl font-normal tracking-wide group-hover:translate-x-1.5 transition-transform duration-300">
            {link.name}
          </span>
          <span class="font-mono text-[11px] text-[#78716C] tracking-widest">
            0{idx + 1}
          </span>
        </a>
      ))
    }
  </div>

  <!-- Drawer Footer Actions -->
  <div class="border-t border-[#E8E2D9] bg-[#FFFDF9] p-6 space-y-3 sticky bottom-0">
    <a
      href="/contact"
      class="mobile-drawer-link flex w-full items-center justify-center space-x-2 rounded-full bg-[#574838] py-3.5 text-xs font-semibold uppercase tracking-[0.2em] text-white shadow-md active:scale-98 hover:bg-[#C5A059] transition-all"
    >
      <span>Reserve Your Wedding Date</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>

    <div class="flex items-center justify-between text-xs text-[#78716C] pt-1">
      <a
        href="https://wa.me/919876543210?text=Hi%20Stories%20by%20Bhavin,%20I'd%20like%20to%20inquire%20about%20wedding%20photography%20availability!"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center space-x-1.5 text-emerald-600 font-medium hover:underline"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        <span>WhatsApp Chat</span>
      </a>

      <a href="tel:+919876543210" class="hover:text-[#574838] transition-colors">
        +91 98765 43210
      </a>
    </div>
  </div>
</div>

<script>
  function setupMobileDrawer() {
    const drawer = document.getElementById('mobile-nav-drawer');
    const openBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-mobile-drawer-btn');
    const drawerLinks = document.querySelectorAll('.mobile-drawer-link');

    function openDrawer() {
      if (!drawer) return;
      drawer.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
      drawer.classList.add('translate-x-0', 'opacity-100');
      document.body.classList.add('overflow-hidden');
    }

    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.remove('translate-x-0', 'opacity-100');
      drawer.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
      document.body.classList.remove('overflow-hidden');
    }

    openBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      openDrawer();
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeDrawer();
    });

    drawerLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeDrawer();
      });
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer && !drawer.classList.contains('translate-x-full')) {
        closeDrawer();
      }
    });
  }

  // Run on page load and on Astro page swaps
  setupMobileDrawer();
  document.addEventListener('astro:page-load', setupMobileDrawer);
</script>
