---
---

<section class="relative w-full bg-[#FAF8F5] py-12 border-b border-[#E8E2D9]">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <div class="rounded-3xl bg-[#FFFDF9] border border-[#C5A059]/40 p-6 sm:p-10 shadow-xl">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        <!-- Title & Subtitle -->
        <div class="space-y-2 text-center lg:text-left max-w-md">
          <div class="inline-flex items-center space-x-2 text-[10px] uppercase tracking-[0.25em] text-[#C5A059] font-semibold">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>2026 - 2027 Season Dates Open</span>
          </div>
          <h3 class="font-display text-2xl sm:text-4xl font-normal text-[#574838]">
            Check Your Wedding Dates
          </h3>
          <p class="text-xs text-[#78716C] font-light leading-relaxed">
            We photograph a limited number of weddings per season. Check date availability instantly via WhatsApp or email.
          </p>
        </div>

        <!-- Quick Form Interactive Inputs -->
        <div class="w-full lg:max-w-xl">
          <form id="quick-date-checker-form" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label for="quick-date" class="block text-[10px] uppercase tracking-wider font-medium text-[#78716C] mb-1.5">
                Wedding Date
              </label>
              <input
                type="date"
                id="quick-date"
                required
                class="w-full rounded-xl border border-[#E8E2D9] bg-white px-3.5 py-2.5 text-xs text-[#1C1917] focus:border-[#C5A059] focus:outline-none"
              />
            </div>

            <div>
              <label for="quick-city" class="block text-[10px] uppercase tracking-wider font-medium text-[#78716C] mb-1.5">
                City / Destination
              </label>
              <input
                type="text"
                id="quick-city"
                placeholder="e.g. Udaipur, Goa"
                required
                class="w-full rounded-xl border border-[#E8E2D9] bg-white px-3.5 py-2.5 text-xs text-[#1C1917] focus:border-[#C5A059] focus:outline-none"
              />
            </div>

            <div class="sm:pt-5">
              <button
                type="submit"
                class="flex w-full items-center justify-center space-x-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold uppercase tracking-[0.15em] text-white shadow-md hover:bg-emerald-700 active:scale-95 transition-all"
              >
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                </svg>
                <span>Check on WhatsApp</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const quickForm = document.getElementById('quick-date-checker-form');
  const dateInput = document.getElementById('quick-date') as HTMLInputElement;
  const cityInput = document.getElementById('quick-city') as HTMLInputElement;

  quickForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const date = dateInput?.value || 'Upcoming Date';
    const city = cityInput?.value || 'Destination';

    const msg = `Hello Stories by Bhavin! I would like to check availability for our wedding on ${date} in ${city}. Please let me know your packages and schedule.`;
    const encoded = encodeURIComponent(msg);
    window.open(`https://wa.me/919876543210?text=${encoded}`, '_blank');
  });
</script>
