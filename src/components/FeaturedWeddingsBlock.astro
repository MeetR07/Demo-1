---
const featuredCards = [
  {
    image: "/images/hero_2.jpg",
    couple: "HARSHITA + NICKY",
    location: "Goa",
    link: "/wedding/rhea-kabir-goa",
    matStyle: "border-none shadow-md",
  },
  {
    image: "/images/udaipur.jpg",
    couple: "RIA + KASHYAP",
    location: "Udaipur",
    link: "/wedding/ananya-sidharth-udaipur",
    matStyle: "p-6 sm:p-8 bg-[#FFFDF8] border border-[#E7E3DF] shadow-sm",
  },
  {
    image: "/images/jaipur.jpg",
    couple: "JOBIN + ANJALI",
    location: "Mumbai",
    link: "/wedding/natasha-varun-jaipur",
    matStyle: "border-none shadow-md",
  },
];
---

<section class="w-full bg-[#F3F2EE] py-20 border-b border-[#E7E3DF]">
  <div class="mx-auto max-w-[1480px] px-4 sm:px-8">
    <!-- 3 Featured Wedding Cards Grid with Reduced Side Margins -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center mb-14">
      {
        featuredCards.map((card) => (
          <a href={card.link} class="group flex flex-col items-center text-center">
            <!-- Photo container with matted frame effect -->
            <div class={`w-full aspect-[3/4] overflow-hidden rounded ${card.matStyle} mb-6 transition-transform duration-500 group-hover:-translate-y-2`}>
              <img
                src={card.image}
                alt={card.couple}
                class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            </div>

            <!-- Couple Name & Location Title -->
            <span class="text-[11px] uppercase tracking-[0.25em] text-[#6B5D4F]/80 font-sans font-medium mb-1 group-hover:text-[#2C2C2C] transition-colors">
              {card.couple}
            </span>
            <h3 class="font-display text-3xl font-normal text-[#6B5D4F] group-hover:text-[#434343] transition-colors">
              {card.location}
            </h3>
          </a>
        ))
      }
    </div>

    <!-- Centered Taupe Pill Button: PHOTOGRAPHY BLOG -->
    <div class="text-center">
      <a
        href="/wedding"
        class="inline-block rounded-full bg-[#6B5D4F] px-10 py-4 text-xs font-semibold uppercase tracking-[0.25em] text-white shadow-md transition-all duration-300 hover:bg-[#434343] hover:shadow-lg transform hover:scale-105"
      >
        Photography Blog
      </a>
    </div>
  </div>
</section>
