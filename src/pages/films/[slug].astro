---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const filmsList = await getCollection("films");
  return filmsList.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"films">;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, location, date, videoUrl } = entry.data;
---

<BaseLayout title={title} description={entry.data.excerpt}>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <p class="text-sm uppercase tracking-[0.15em] text-brass">
      {location} &middot; {date.toLocaleDateString("en-IN", { month: "long", year: "numeric" })}
    </p>
    <h1 class="mt-2 text-4xl">{title}</h1>

    <div class="my-10 aspect-video w-full overflow-hidden rounded bg-ink">
      <iframe
        class="h-full w-full"
        src={videoUrl}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>

    <div class="prose prose-neutral max-w-none text-inksoft">
      <Content />
    </div>
  </article>
</BaseLayout>
