---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const shoots = await getCollection("editorial");
  return shoots.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"editorial">;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, location, date, cover, gallery } = entry.data;
---

<BaseLayout title={title} description={entry.data.excerpt}>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <p class="text-sm uppercase tracking-[0.15em] text-brass">
      {location} &middot; {date.toLocaleDateString("en-IN", { month: "long", year: "numeric" })}
    </p>
    <h1 class="mt-2 text-4xl">{title}</h1>
    <img src={cover} alt={title} class="my-10 w-full rounded" loading="eager" />
    <div class="prose prose-neutral max-w-none text-inksoft">
      <Content />
    </div>
    {
      gallery.length > 1 && (
        <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3">
          {gallery.map((src) => (
            <img src={src} alt="" loading="lazy" class="aspect-square w-full rounded object-cover" />
          ))}
        </div>
      )
    }
  </article>
</BaseLayout>
