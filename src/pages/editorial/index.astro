---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MiddleGrid from "../../components/MiddleGrid.astro";
---

<BaseLayout title="Editorial Shoots | Stories by Bhavin" description="High-fashion pre-wedding editorial portraits and styled couple sessions.">
  <!-- Header Banner -->
  <section class="w-full bg-[#1E1C1A] py-24 text-white text-center">
    <div class="mx-auto max-w-4xl px-6">
      <span class="text-xs uppercase tracking-[0.3em] text-[#9F9483] font-semibold block mb-3">
        High Fashion & Pre-Weddings
      </span>
      <h1 class="font-display text-4xl sm:text-6xl font-normal tracking-wide text-white mb-4">
        Editorial & Concept Shoots
      </h1>
      <p class="text-xs sm:text-sm text-white/70 max-w-lg mx-auto font-light leading-relaxed">
        Curated pre-wedding concepts, editorial portraits, and stylized couple shoots across breathtaking outdoor landscapes.
      </p>
    </div>
  </section>

  <!-- Editorial Masonry Gallery -->
  <MiddleGrid />
</BaseLayout>
