---
import BaseLayout from "../layouts/BaseLayout.astro";
import InquiryForm from "../components/InquiryForm.astro";
---

<BaseLayout title="Contact & Inquiries" description="Reserve your wedding date with Stories by Bhavin. Fine Art Destination Wedding Photography & Films.">
  <!-- Header Banner -->
  <section class="w-full bg-paper-dark py-20 text-paper text-center">
    <div class="mx-auto max-w-4xl px-6">
      <span class="text-xs uppercase tracking-[0.3em] text-gold font-semibold block mb-2">
        Get In Touch
      </span>
      <h1 class="font-display text-4xl sm:text-6xl font-semibold text-white mb-4">
        Start Your Story With Us
      </h1>
      <p class="text-xs sm:text-sm text-white/70 max-w-lg mx-auto font-light leading-relaxed">
        Whether you are planning a royal palace wedding in Rajasthan, a beach retreat in Goa, or an international destination, we would love to hear your vision.
      </p>
    </div>
  </section>

  <!-- Contact Methods Cards -->
  <section class="w-full bg-paper py-16 border-b border-border-light">
    <div class="mx-auto max-w-5xl px-6 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-card p-8 rounded-2xl text-center space-y-3 border border-border-light">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-gold/20 text-gold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h4 class="font-display font-semibold text-xl text-ink">Email Us</h4>
          <p class="text-xs text-ink-muted">hello@storiesbybhavin.com</p>
          <a href="mailto:hello@storiesbybhavin.com" class="text-xs uppercase tracking-[0.15em] text-gold font-medium block hover:underline">Write Email &rarr;</a>
        </div>

        <div class="glass-card p-8 rounded-2xl text-center space-y-3 border border-border-light">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-gold/20 text-gold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h4 class="font-display font-semibold text-xl text-ink">Call / WhatsApp</h4>
          <p class="text-xs text-ink-muted">+91 98765 43210</p>
          <a href="https://wa.me/919876543210" target="_blank" rel="noopener" class="text-xs uppercase tracking-[0.15em] text-gold font-medium block hover:underline">Chat on WhatsApp &rarr;</a>
        </div>

        <div class="glass-card p-8 rounded-2xl text-center space-y-3 border border-border-light">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-gold/20 text-gold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h4 class="font-display font-semibold text-xl text-ink">Mumbai Studio</h4>
          <p class="text-xs text-ink-muted">Studio 402, Bandra West, Mumbai</p>
          <span class="text-xs uppercase tracking-[0.15em] text-gold font-medium block">By Appointment Only</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Form -->
  <InquiryForm />
</BaseLayout>
