---
import BaseLayout from "../layouts/BaseLayout.astro";
import InquiryForm from "../components/InquiryForm.astro";
---

<BaseLayout title="About Bhavin & Team" description="Learn about Stories by Bhavin — fine art wedding photographers and filmmakers based in Mumbai.">
  <!-- Hero Section -->
  <section class="w-full bg-paper-dark py-24 text-paper relative overflow-hidden">
    <div class="mx-auto max-w-5xl px-6 md:px-10 text-center relative z-10">
      <span class="text-xs uppercase tracking-[0.3em] text-gold font-semibold block mb-3">
        Our Story & Philosophy
      </span>
      <h1 class="font-display text-4xl sm:text-6xl font-semibold text-white max-w-3xl mx-auto leading-tight mb-6">
        Behind The Lens With Stories By Bhavin
      </h1>
      <p class="text-sm text-white/70 max-w-xl mx-auto font-light leading-relaxed">
        Crafting emotive, timeless wedding photography and cinematic films across India, Europe, and worldwide destinations.
      </p>
    </div>
  </section>

  <!-- Detailed Story Section -->
  <section class="w-full bg-paper py-24">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-24">
        <div class="lg:col-span-6 relative">
          <div class="rounded-3xl overflow-hidden shadow-2xl border border-border-light">
            <img src="/images/bhavin.jpg" alt="Bhavin portrait" class="w-full h-auto object-cover" />
          </div>
        </div>

        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs uppercase tracking-[0.3em] text-gold font-semibold block">
            Meet Bhavin
          </span>
          <h2 class="font-display text-4xl font-semibold text-ink">
            "Every frame is a heritage heirloom."
          </h2>

          <p class="text-sm text-ink-muted leading-relaxed font-light">
            My journey began over 12 years ago with a passion for street photography and human emotions. Capturing spontaneous, unscripted moments taught me that real beauty lies in raw authenticity.
          </p>

          <p class="text-sm text-ink-muted leading-relaxed font-light">
            When I shot my first destination wedding in Rajasthan, I realized that weddings are living tapestries of family history, rituals, tears, and joy. That inspiration gave birth to <strong>Stories by Bhavin</strong>.
          </p>

          <p class="text-sm text-ink-muted leading-relaxed font-light">
            Today, our boutique team consists of world-class cinematographers, colorists, and fine art photographers who share the same commitment: capturing your day so authentically that 20 years from now, you can feel every emotion all over again.
          </p>
        </div>
      </div>

      <!-- Values Grid -->
      <div class="border-t border-border-light pt-20">
        <div class="text-center max-w-xl mx-auto mb-16">
          <span class="text-xs uppercase tracking-[0.3em] text-gold font-semibold block mb-2">
            Why Choose Us
          </span>
          <h3 class="font-display text-3xl sm:text-4xl font-semibold text-ink">
            Our Core Values
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="glass-card p-8 rounded-2xl border border-border-light text-center space-y-4">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-gold/20 text-gold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <h4 class="font-display text-2xl font-semibold text-ink">Unobtrusive Eye</h4>
            <p class="text-xs text-ink-muted leading-relaxed font-light">
              We blend seamlessly into your celebration so you and your loved ones can remain fully present in the moment.
            </p>
          </div>

          <div class="glass-card p-8 rounded-2xl border border-border-light text-center space-y-4">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-gold/20 text-gold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            </div>
            <h4 class="font-display text-2xl font-semibold text-ink">Fine-Art Grading</h4>
            <p class="text-xs text-ink-muted leading-relaxed font-light">
              Every photograph and film frame is hand-edited with rich color palettes, warm undertones, and timeless tone curves.
            </p>
          </div>

          <div class="glass-card p-8 rounded-2xl border border-border-light text-center space-y-4">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-gold/20 text-gold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h4 class="font-display text-2xl font-semibold text-ink">Bespoke Focus</h4>
            <p class="text-xs text-ink-muted leading-relaxed font-light">
              By taking a strictly limited number of weddings per year, we ensure meticulous care and personal dedication to your story.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <InquiryForm />
</BaseLayout>
