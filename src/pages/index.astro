---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSlider from "../components/HeroSlider.astro";
import MiddleGrid from "../components/MiddleGrid.astro";
import FeaturedWeddingsBlock from "../components/FeaturedWeddingsBlock.astro";
import QuickDateChecker from "../components/QuickDateChecker.astro";
import CinemaMomentsBanner from "../components/CinemaMomentsBanner.astro";
import FilmSection from "../components/FilmSection.astro";
import ExperiencePackages from "../components/ExperiencePackages.astro";
import Testimonials from "../components/Testimonials.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import InquiryForm from "../components/InquiryForm.astro";
import MobileBottomNav from "../components/MobileBottomNav.astro";
---

<BaseLayout title="Fine Art Wedding Photographer & Films ( STORIES BY BHAVIN )">
  <!-- Section 1: Hero Carousel Header with Swipe & Dual CTAs -->
  <HeroSlider />

  <!-- Section 2: Locations & Destination Marquee Banner -->
  <section class="w-full bg-[#FAF8F5] py-10 sm:py-14 border-b border-[#E8E2D9] text-center overflow-hidden">
    <div class="mx-auto max-w-[1480px] px-4 sm:px-8">
      <div class="flex items-center justify-center space-x-2 text-[10px] uppercase tracking-[0.3em] text-[#C5A059] font-medium mb-3">
        <span>&bull;</span>
        <span>Worldwide Destination Coverage</span>
        <span>&bull;</span>
      </div>
      <h2 class="font-display text-2xl sm:text-4xl lg:text-5xl font-normal uppercase tracking-[0.18em] text-[#574838]">
        Mumbai &bull; Udaipur &bull; Jaipur &bull; Goa &bull; Dubai &bull; London
      </h2>
    </div>
  </section>

  <!-- Section 3: Bio / Story Editorial Block with Stats Counter -->
  <section class="w-full bg-[#FAF8F5] py-20 sm:py-28 border-b border-[#E8E2D9]">
    <div class="mx-auto max-w-[1480px] px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left Vertical Photo with Mat Effect -->
        <div class="lg:col-span-5 overflow-hidden rounded-3xl border border-[#E8E2D9] bg-white p-3 sm:p-4 shadow-xl group">
          <div class="relative overflow-hidden rounded-2xl aspect-[3/4] max-h-[520px]">
            <img
              src="/images/udaipur.jpg"
              alt="Luxury wedding couple portrait"
              class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute bottom-4 left-4 right-4 rounded-xl bg-black/60 backdrop-blur-md p-3.5 text-white border border-white/20">
              <span class="text-[9px] uppercase tracking-[0.25em] text-[#DFC289] font-mono">Stories by Bhavin</span>
              <p class="font-display text-sm tracking-wide mt-0.5">"Capturing love as a timeless heirloom"</p>
            </div>
          </div>
        </div>

        <!-- Middle Text Philosophy Block -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center space-x-2 rounded-full border border-[#C5A059]/40 bg-[#FFFDF9] px-4 py-1.5 shadow-sm">
            <span class="text-[10px] sm:text-xs uppercase tracking-[0.25em] text-[#C5A059] font-semibold">
              The Philosophy
            </span>
          </div>

          <h3 class="font-display text-3xl sm:text-5xl font-normal text-[#574838] leading-tight">
            “Tradition redefined through modern editorial storytelling.”
          </h3>
          
          <div class="space-y-4 text-xs sm:text-sm text-[#78716C] leading-relaxed font-light">
            <p class="text-[#1C1917] font-medium leading-relaxed">
              Recognized for its artistic vision and emotional storytelling, Stories by Bhavin has been redefining fine-art wedding photography and cinematography across India and international destinations since 2017.
            </p>
            <p>
              We believe great wedding imagery shouldn't feel staged or rehearsed. Our team blends editorial elegance with pure documentary discretion — ensuring you remain immersed in your celebrations while we immortalize every quiet glance, joyous tear, and ecstatic dance.
            </p>
          </div>

          <!-- Stats Grid: 4 Pillars of Excellence -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-[#E8E2D9]">
            <div class="rounded-2xl bg-white p-4 border border-[#E8E2D9] text-center shadow-sm">
              <span class="font-display text-3xl sm:text-4xl font-normal text-[#C5A059] block">9+</span>
              <span class="text-[10px] uppercase tracking-wider text-[#78716C]">Years Crafting</span>
            </div>
            <div class="rounded-2xl bg-white p-4 border border-[#E8E2D9] text-center shadow-sm">
              <span class="font-display text-3xl sm:text-4xl font-normal text-[#C5A059] block">350+</span>
              <span class="text-[10px] uppercase tracking-wider text-[#78716C]">Couples Documented</span>
            </div>
            <div class="rounded-2xl bg-white p-4 border border-[#E8E2D9] text-center shadow-sm">
              <span class="font-display text-3xl sm:text-4xl font-normal text-[#C5A059] block">14+</span>
              <span class="text-[10px] uppercase tracking-wider text-[#78716C]">Destinations</span>
            </div>
            <div class="rounded-2xl bg-white p-4 border border-[#E8E2D9] text-center shadow-sm">
              <span class="font-display text-3xl sm:text-4xl font-normal text-[#C5A059] block">100%</span>
              <span class="text-[10px] uppercase tracking-wider text-[#78716C]">Artistic Focus</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Curated Photo Gallery with Category Filters & Next/Prev Lightbox -->
  <MiddleGrid />

  <!-- Section 5: Featured Wedding Stories -->
  <FeaturedWeddingsBlock />

  <!-- Section 6: Instant Date Availability Checker Widget -->
  <QuickDateChecker />

  <!-- Section 7: Cinema Moments Dark Banner -->
  <CinemaMomentsBanner />

  <!-- Section 8: Wedding Cinema Highlights (2x2 Grid) -->
  <FilmSection />

  <!-- Section 9: Investment & Experience Packages -->
  <ExperiencePackages />

  <!-- Section 10: Couple Testimonials Slider -->
  <Testimonials />

  <!-- Section 11: FAQ Accordion -->
  <FaqAccordion />

  <!-- Section 12: Booking & Inquiry Form -->
  <InquiryForm />

  <!-- Native Mobile Bottom Navigation Dock (Visible on mobile/tablets) -->
  <MobileBottomNav />
</BaseLayout>

