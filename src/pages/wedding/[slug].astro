---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const weddings = await getCollection("weddings");
  return weddings.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"weddings">;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const { couple, location, date, cover, gallery, excerpt } = entry.data;
---

<BaseLayout title={`${couple} — Wedding Story`} description={excerpt}>
  <!-- Story Hero Header -->
  <section class="relative h-[65vh] min-h-[450px] w-full overflow-hidden bg-paper-dark">
    <img src={cover} alt={couple} class="h-full w-full object-cover object-center opacity-85" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-paper-dark via-paper-dark/30 to-black/30"></div>

    <div class="absolute bottom-12 inset-x-0 mx-auto max-w-5xl px-6 md:px-10 text-paper z-10">
      <span class="text-xs uppercase tracking-[0.3em] text-gold font-semibold block mb-2">
        {location} &bull; {date.toLocaleDateString("en-IN", { month: "long", year: "numeric" })}
      </span>
      <h1 class="font-display text-4xl sm:text-6xl font-semibold text-white tracking-wide">
        {couple}
      </h1>
    </div>
  </section>

  <!-- Story Content -->
  <article class="mx-auto max-w-4xl px-6 py-20 md:px-10">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="font-display italic text-2xl text-ink leading-relaxed">
        "{excerpt}"
      </p>
      <div class="w-12 h-0.5 bg-gold mx-auto mt-6"></div>
    </div>

    <!-- Prose Story Text -->
    <div class="prose prose-lg max-w-none text-ink-muted leading-relaxed font-light mb-16 space-y-6">
      <Content />
    </div>

    <!-- Gallery Grid -->
    {
      gallery && gallery.length > 0 && (
        <div class="mt-16 pt-12 border-t border-border-light">
          <span class="text-xs uppercase tracking-[0.3em] text-gold font-semibold block mb-6 text-center">
            Photo Highlights
          </span>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
            {gallery.map((src, i) => (
              <div class="group relative aspect-[4/3] overflow-hidden rounded-xl bg-paper-dark shadow-md">
                <img
                  src={src}
                  alt={`${couple} photo ${i + 1}`}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
            ))}
          </div>
        </div>
      )
    }

    <!-- Inquiry CTA -->
    <div class="mt-20 rounded-3xl bg-paper-dark p-10 text-center text-paper shadow-2xl border border-white/10">
      <span class="text-xs uppercase tracking-[0.3em] text-gold font-semibold block mb-2">
        Plan Your Wedding
      </span>
      <h3 class="font-display text-3xl font-semibold text-white mb-4">
        Love What You See?
      </h3>
      <p class="text-xs text-white/70 max-w-md mx-auto mb-8 font-light leading-relaxed">
        Let's capture your unique love story with the same artistic dedication and warmth.
      </p>
      <a
        href="/contact"
        class="inline-block rounded-full bg-gold px-8 py-3.5 text-xs font-semibold uppercase tracking-[0.2em] text-ink shadow-lg transition-transform hover:scale-105"
      >
        Inquire For Dates
      </a>
    </div>
  </article>
</BaseLayout>
