---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioGrid from "../../components/PortfolioGrid.astro";

const weddingsCollection = await getCollection("weddings");
const weddings = weddingsCollection
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((w) => ({
    href: `/wedding/${w.slug}`,
    cover: w.data.cover,
    title: w.data.couple,
    location: w.data.location,
    date: w.data.date,
    excerpt: w.data.excerpt,
  }));
---

<BaseLayout title="Weddings | Stories by Bhavin" description="Explore fine art wedding photography galleries captured across India, Europe, and destination venues worldwide.">
  <!-- Header Banner -->
  <section class="w-full bg-[#1E1C1A] py-24 text-white text-center">
    <div class="mx-auto max-w-4xl px-6">
      <span class="text-xs uppercase tracking-[0.3em] text-[#9F9483] font-semibold block mb-3">
        Portfolio Showcase
      </span>
      <h1 class="font-display text-4xl sm:text-6xl font-normal tracking-wide text-white mb-4">
        Real Wedding Stories
      </h1>
      <p class="text-xs sm:text-sm text-white/70 max-w-lg mx-auto font-light leading-relaxed">
        Every story is an authentic tapestry of raw emotion, cultural rituals, and timeless romantic moments.
      </p>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section class="w-full bg-[#FFFDF8] py-24">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <PortfolioGrid items={weddings} />
    </div>
  </section>
</BaseLayout>
